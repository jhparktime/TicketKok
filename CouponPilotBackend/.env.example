# 공공데이터포털에서 발급받은 서비스 키. 절대 iOS 앱 또는 Git에 넣지 않습니다.
DATA_GO_KR_SERVICE_KEY=replace-with-data-go-kr-service-key

# Cloud Run에서는 프로젝트 ID를 명시하고, 런타임 서비스 계정의 Vertex AI 권한을 사용합니다.
VERTEX_PROJECT_ID=proj-aj21-211200020328
VERTEX_LOCATION=global

# API/MCP boundary only. It stays disabled in tests and until explicitly true. Cloud Run uses ADC.
# Prompt content and raw coupon/OCR/PAN/UID values are never trace attributes; ADK tracing is separate.
GOOGLE_CLOUD_TRACE_ENABLED=false

# 공식 통신사 혜택 문서와 임베딩 인덱스가 저장된 비공개 버킷입니다.
BENEFITS_BUCKET=coupon-pilot-benefits-601392084114
# Similarity below this value is treated as "no official evidence".
BENEFIT_RAG_MIN_SCORE=0.35
# Keep false on the API service. A separate ingestion job with bucket write access publishes data.
BENEFIT_RUNTIME_SEED_PERSIST=false
# Production requires a second operator to approve a benefit candidate. Local demos may set this
# to true temporarily, but must never use it in a production Cloud Run revision.
BENEFIT_ALLOW_SELF_APPROVAL=false
# Extra providers must be scoped as provider=domain. A bare global domain is rejected.
# BENEFIT_OFFICIAL_DOMAIN_ALLOWLIST=신규카드사=card.example.co.kr

# ADK Cloud Run만 MCP를 호출하도록 공유 토큰을 Secret Manager에서 두 서비스에 주입합니다.
# 배포 환경에서는 Cloud Run Invoker IAM도 함께 적용합니다.
MCP_INTERNAL_TOKEN=replace-with-random-internal-token

# ADK는 처음에는 shadow 모드로 실행해 기존 계산 결과를 바꾸지 않고 Trace만 비교합니다.
ADK_ORCHESTRATOR_URL=https://couponcok-adk-REPLACE.run.app
ADK_INTERNAL_TOKEN=replace-with-a-different-random-token
# Firebase UID를 ADK용 가명 reference로 바꾸는 환경별 32바이트 이상 HMAC 키입니다.
# 다른 환경과 재사용하지 않고 Secret Manager에서만 주입합니다.
PSEUDONYMIZATION_KEY=replace-with-a-32-byte-or-longer-random-key
ADK_ORCHESTRATION_MODE=shadow
# Shadow evaluation is a cost-bearing duplicate path. Production beta samples 10% deterministically.
ADK_SHADOW_SAMPLE_RATE=0.10
ADK_TIMEOUT_MS=12000

# Defense in depth for text that may later reach Gemini/ADK. Start in monitor only after the
# runtime service account has the relevant minimal role, then move to enforce after review.
DLP_MODE=off
DLP_PROJECT_ID=proj-aj21-211200020328
DLP_TIMEOUT_MS=3000
MODEL_ARMOR_MODE=off
MODEL_ARMOR_PROJECT_ID=proj-aj21-211200020328
MODEL_ARMOR_LOCATION=asia-northeast3
# MODEL_ARMOR_TEMPLATE=couponcok-safety-v1
MODEL_ARMOR_TIMEOUT_MS=3000
DLP_IMAGE_TIMEOUT_MS=5000

# External place verification: Google Maps Grounding Lite MCP is primary. The iOS precision
# coordinate is rounded to a 0.01-degree grid before it leaves Cloud Run. Kakao is only an
# official REST API fallback and is never called through a community-operated MCP server.
GOOGLE_MAPS_API_KEY=replace-with-a-restricted-mapstools-api-key
KAKAO_REST_API_KEY=replace-with-kakao-local-rest-api-key

# Start a candidate revision in monitor mode. Switch to enforce only after iOS App Attest
# tokens and simulator debug tokens have been registered in Firebase App Check.
APP_CHECK_ENFORCEMENT_MODE=monitor
