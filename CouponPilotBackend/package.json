{
  "name": "coupon-pilot-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test": "npm run test:safety && npm run test:golden && npm run test:api && npm run test:mcp",
    "test:safety": "NODE_ENV=test tsx test/cloudSafety.test.ts",
    "test:golden": "NODE_ENV=test tsx test/golden.test.ts",
    "test:api": "NODE_ENV=test tsx test/server.test.ts",
    "test:mcp": "tsx test/mcp.test.ts",
    "start": "node dist/server.js",
    "start:mcp": "node dist/mcpServer.js",
    "sync:stores": "tsx src/jobs/syncStoreDirectory.ts",
    "ingest:benefit": "tsx scripts/ingestBenefit.ts",
    "approve:benefit": "tsx scripts/approveBenefit.ts",
    "retire:benefit": "tsx scripts/retireBenefit.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.16.0",
    "@google-cloud/opentelemetry-cloud-trace-exporter": "^3.1.0",
    "@google/genai": "^2.16.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.221.0",
    "express": "^5.1.0",
    "firebase-admin": "^13.4.0",
    "google-auth-library": "^10.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
